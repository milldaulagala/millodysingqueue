# Local development only. Copy to .env and replace all three passwords,
# or run ./scripts/setup-local-env.sh to generate random passwords securely.
# This file is also sourced by scripts/db.sh: use shell-compatible assignments.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-a-unique-admin-password
MIGRATION_DB_PASSWORD=replace-with-a-unique-migration-password
APPLICATION_DB_PASSWORD=replace-with-a-unique-application-password
MIGRATION_DB_URL=jdbc:postgresql://127.0.0.1:${POSTGRES_PORT}/millodysingqueue
MIGRATION_DB_USER=millody_migrator
APPLICATION_DB_URL=jdbc:postgresql://127.0.0.1:${POSTGRES_PORT}/millodysingqueue
APPLICATION_DB_USER=millody_app
